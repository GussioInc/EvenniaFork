# Evennia batch build file for New Thalos

# Rooms
ev.create_object("typeclasses.rooms.Room", key="The Grand Gate of Thalos", attributes=[("desc", """You stand in the archway of a gigantic stone archway. The two
steel gates have been forced open and have rusted in place. A hollow
gust of wind blows by you into the deserted, and seemingly destroyed,
city."""), ("vnum", 5200)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Main Street", attributes=[("desc", """This was once a magnificent street, but now is in total ruin. The
streets are barren and windswept and the silence is unending.  A dark alley
leads north and south.  Howls and screams echo through the deserted city."""), ("vnum", 5201)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Main Street", attributes=[("desc", """This was once a magnificent street, but now is in total ruin. The
streets are barren and windswept and the silence is unending. On one
side is a collapsed house while on the other is the entrance to a large
ruined mansion. Eerie sounds echo within the mansion. Near the center of
town you see a large domed building, relatively intact."""), ("vnum", 5202)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Garden Path", attributes=[("desc", """A circular path surrounds a magnificent domed temple in the center of
the city. Flowers have withered away and the once lush trees are bare.
Vines and ivy snake up the sides of the temple and entangle themselves
around your feet. A sudden volley of howls pierces the air."""), ("vnum", 5203)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Garden Path", attributes=[("desc", """A circular path surrounds a magnificent domed temple in the center of
the city. Flowers have withered away and the once lush trees are bare.
Vines and ivy snake up the sides of the temple and entangle themselves
around your feet. A sudden volley of howls pierces the air."""), ("vnum", 5204)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Garden Path", attributes=[("desc", """A circular path surrounds a magnificent domed temple in the center of
the city. Flowers have withered away and the once lush trees are bare.
Vines and ivy snake up the sides of the temple and entangle themselves
around your feet. A sudden volley of howls pierces the air."""), ("vnum", 5205)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Garden Path", attributes=[("desc", """A circular path surrounds a magnificent domed temple in the center of
the city. Flowers have withered away and the once lush trees are bare.
Vines and ivy snake up the sides of the temple and entangle themselves
around your feet. A sudden volley of howls pierces the air."""), ("vnum", 5206)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The market place", attributes=[("desc", """You stand in the middle of a large square lined on each side with
baskets, carts, and stands of all shapes and sizes. Abandoned, these
little shops still contain some of their goods once sold to a demanding
public."""), ("vnum", 5207)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The market place", attributes=[("desc", """You stand at the end of the market square. Stands and carts line
each side, filled with remnants of fine foods and exquisite goods."""), ("vnum", 5208)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Side Street", attributes=[("desc", """This small side street leads east and west into back alleys while
to the south you see the temple. The incessant howling tears at your mind."""), ("vnum", 5209)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Side Street", attributes=[("desc", """You are in the common section of the city. Ruined buildings made of
clay and stone is all the view has to offer. Most of these homes are
nothing but piles of rubble, but some look almost safe enough to venture
into. The street continues north and south and buildings line the street."""), ("vnum", 5210)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A Side Street", attributes=[("desc", """This small side street leads away from the garden path to the south.
Around you stand large piles or rubble where the houses of commoners
used to be. A lone howl makes you worry greatly about your safety here."""), ("vnum", 5211)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A side street", attributes=[("desc", """This small side street leads south away from the temple into the
business section of town. The destruction that leveled this city was not
biased; these important looking buildings have been almost totally
destroyed. There is a hole in the wall of a very large structure to the
east."""), ("vnum", 5212)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A side street", attributes=[("desc", """This small side street is lined with the remains of once great
buildings. To the north is a dark, foreboding structure while to the
east lies the entrance to a small tavern. The street continues north
and south."""), ("vnum", 5213)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A side street", attributes=[("desc", """You are at the end of a long street leading to the center of the city.
A long dark alley runs east and west."""), ("vnum", 5214)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Under a ruined watchtower", attributes=[("desc", """You stand at the base of a tall watchtower built to protect the city
from invaders. From the looks of things, it did not do a good job."""), ("vnum", 5215)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """This alley leads to the rear of what used to be a meat stand. You wince
at the stench. South is one of the city watchtowers."""), ("vnum", 5216)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The meat stand", attributes=[("desc", """A large stand has been set up here with metal hooks and wooden racks
in the background. Hanging on the hooks are very small scraps of meat
and other game. This stand is relatively empty, and a sudden burst of
howling and screaming makes you realize why this is so."""), ("vnum", 5217)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads east to a wider street and west to one of
the city watchtowers."""), ("vnum", 5218)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The guild house", attributes=[("desc", """You are standing in what once was this city's ONLY guild house.
Tables and chairs have been smashed and broken weapons lie strewn about
the floor as if some massive battle had taken place here. Draped along
the back wall is a tattered, jet-black banner with the symbol of the
Darkside set upon it."""), ("vnum", 5219)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The produce stand", attributes=[("desc", """A large cart sits here carrying rotted fruit and vegetables. Flys
swarm all about what seems to be the last remaining bits of food left
in the city."""), ("vnum", 5220)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The smithy", attributes=[("desc", """In here you find tools and anvils used to make various weapons
and items. The walls have been stripped clean and only a few incomplete
pieces of armor and weaponry are left."""), ("vnum", 5221)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The tapestry stand", attributes=[("desc", """Tattered and torn tapestries and rugs lie heaped in piles. Fancy
robes and various articles of clothing are now just rags. You stare at
the strange piles for a long time until a piercing howl makes you
think these might be beds."""), ("vnum", 5222)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads north to one of the city watchtowers while
to the south there lies a market stand full of torn clothes and rugs."""), ("vnum", 5223)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Under the watchtower", attributes=[("desc", """You stand under one of the city watchtowers built to protect
the city from invaders. Obviously, it failed."""), ("vnum", 5224)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The jewelery stand", attributes=[("desc", """A table has been tipped over, spilling fine jewelery and gems
across the market place. Most of these trinkets are battered and
tarnished and few would have any value anymore."""), ("vnum", 5225)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A ruined clay dwelling", attributes=[("desc", """This was once a very plain house with nothing more than a few chairs
and a bed. A cold fireplace suggests that the city has been abandoned
for quite a while. Almost nothing remains of this humble abode."""), ("vnum", 5226)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A collapsed stone dwelling", attributes=[("desc", """This small house has completely collapsed upon itself leaving piles
of debris here and there. A few rafters still stand with thatched straw
hanging down and a hot wind gusts through the hollow dwelling."""), ("vnum", 5227)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads east to one of the city watchtowers and west to
a small side street."""), ("vnum", 5228)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="An abandoned shop", attributes=[("desc", """From the outside this place looks like an ordinary pile of rubble,
but inside these cramped quarters you discover what used to be a shop
filled with armor, weapons, and various other goods. A small sign flutters
in the wind."""), ("vnum", 5229)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The Tavern of the Sun", attributes=[("desc", """A glorious place in it's prime, this tavern now lies in ruin; tables
and chairs are broken scattered, bottles and glasses shattered, and
a small performance stage crushed. Musical instruments and personal
belongings lie under the rubble, but the people they once belonged to are
not with them. Looking up you see that the entire second floor and roof
has fallen in, leaving a gaping hole above."""), ("vnum", 5230)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="South wing of the city hall", attributes=[("desc", """You stand in a large room attached to this end of the hallway which
leads back north to the reception area.  Pedestals and columns have fallen
and most of the valuable items have been taken, leaving worthless debris.
A few chairs have survived, as well as a large curved desk. To the east
is a vine-covered archway leading out into a private courtyard."""), ("vnum", 5231)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The city hall", attributes=[("desc", """This is the main reception area of Thalos' city hall. The walls have
been charred and scored massively and debris is spread from wall to wall.
A large gaping hole in the west wall allows you to see out to one of
the city's side streets. Obviously no one will be seeing you through today.
Hallways lead south and east."""), ("vnum", 5232)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="East wing of the city hall", attributes=[("desc", """Here lies the remnants of a fancy office, possibly the mayor's. A few
withered plants and broken pieces of furniture make this place anything
but fancy, though. The only thing remaining intact here is a large
glass cabinet. A long hallway leads west back to the reception area and
an ivy-covered archway leads south into a private courtyard."""), ("vnum", 5233)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The private gardens and courtyard of Thalos", attributes=[("desc", """What a shame that this mass destruction also touched this once
beautiful place. The temple's garden path has nothing on this garden.
Flowers and trees have been smashed into the ground and lawn benches
thrown through walls. A large marble fountain in the center of the
courtyard still stands, though, defying any attempts to destroy its
beauty. Above stands the remnants of one of the watchtowers. Archways
north and west lead back into the city hall."""), ("vnum", 5234)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A small guard house", attributes=[("desc", """This was once the barracks for Thalos' cityguards. Now just an empty
shell, this small shack still stands guarding the entrance both to the
city and to the city hall."""), ("vnum", 5235)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A collapsed home", attributes=[("desc", """All that's left of this house is a few scattered piles of rubble
and a very large blast crater. Obviously someone or something important
was once housed here. A shrieking howl chills your blood."""), ("vnum", 5236)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A tall dwelling", attributes=[("desc", """This seems to be the tallest structure remaining in the city. At
one time this could have been an inn of some sort, but now it's just
a mess. The back wall as been completely knocked down revealing an
entrance into another building through yet another collapsed wall.
Between the two buildings are a few blast craters and boulders. An old
set of wooden steps leads up to a creaking second floor."""), ("vnum", 5237)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A small shack", attributes=[("desc", """This cramped dwelling could not have housed more than one person. Now
with the back wall missing, it could hold many more. Looking around you
find broken shelves and workbenches with various vials and pouches spilling
contents all across the floor. This was possibly the magic shop of the
city. The doorway to the east is blocked, making the only exit back west."""), ("vnum", 5238)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow back alley goes south to main street and north towards
a watchtower. A mass of howls catches you off guard."""), ("vnum", 5239)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow back alley leads north to one of the city watchtowers
and south towards main street. To the west is a doorway to a small
house blocked by debris."""), ("vnum", 5240)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Under a watchtower", attributes=[("desc", """You stand under a tall watchtower. Narrow back alleys lead west and
south and a very weak looking ladder leads up into the tower."""), ("vnum", 5241)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A bath house", attributes=[("desc", """This was once the bath house for the commoners of the city. Hot
steamy water still wells up from a hole in the floor. Obviously there
is a hot spring located under the city (making the decision to put
a city here seem much more reasonable). Closer inspection of the water
yields a dead body floating around in it, skin melted away from months
of floating in there. The west wall has collapsed revealing another
collapsed house."""), ("vnum", 5242)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow back alley leads west to a small side street and east to one
of the city watchtowers. Great amounts of steam issue forth from the
building to the south."""), ("vnum", 5243)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="An upright house", attributes=[("desc", """This home is practically the only one around that is still standing.
Except for the massive hole in the east wall, everything else looks
intact, including the windows. Great amounts of steam issue forth from
the hole in the east wall."""), ("vnum", 5244)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="On the second floor", attributes=[("desc", """The minute you step off onto this floor you realize it was a mistake.
The old rotted floorboards suddenly give way and you fall down, impaling
yourself on jagged boards below.

You've fallen, and you can't get up!!!"""), ("vnum", 5245)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="The north-west watchtower", attributes=[("desc", """You stand atop one of the city watchtowers. The view is magnificent
from here and you can see all the way to the western mountains. No wonder
this place stood for so long."""), ("vnum", 5246)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The south-west watchtower", attributes=[("desc", """You stand atop one of the city watchtowers. The view is magnificent
from here and you can see all the way to the western mountains. To the
south the desert stretches to the horizon. No wonder this place stood
for so long."""), ("vnum", 5247)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The north-east watchtower", attributes=[("desc", """You stand atop one of the city watchtowers. The view is magnificent
from here and you can see a great floating pyramid to the north-east.
Desert sand stretches to the horizon. No wonder this place stood for so
long."""), ("vnum", 5248)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The Temple of Thalos", attributes=[("desc", """You stand within one of the most holy places in the realm. This
stunning domed temple once housed the city's worshipers en masse.
Unfortunately, it succumbed to the destruction brought on this city.
Long benches lie toppled and the altar desecrated. Large chunks of stone
have fallen from the walls and roof, sending sunlight streaming in on
you. A few books lie about, conveying to you a holy message in a
strange tongue.
     Wind gusts through the four archways and howls and screams can be
heard from all parts of the city."""), ("vnum", 5250)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads east to a wider street and west to one of
the city watchtowers."""), ("vnum", 5251)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="Under a ruined watchtower", attributes=[("desc", """You stand at the base of a tall watchtower built to protect the city
from invaders. From the looks of things, it did not do a good job."""), ("vnum", 5252)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads south to one of the city watchtowers."""), ("vnum", 5253)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The south-east watchtower", attributes=[("desc", """You stand atop one of the city watchtowers. The view is magnificent
from here and you can see all the way to the western mountains. To the
south the desert stretches to the horizon. No wonder this place stood
for so long.  There is a small plaque on the stones."""), ("vnum", 5254)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A back alley", attributes=[("desc", """A narrow alley leads north to the main street, and south toward a tall
watchtower.  A ruined building is to the west."""), ("vnum", 5255)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A trail at the end of the dwarf forest", attributes=[("desc", """The trail ends here, with short, dry stumps of trees all around you.
To the west, you can see the ruins of a huge city.  Something about it gives
you an uneasy feeling.  To the east is your way back to home and safety."""), ("vnum", 5256)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A trail at the end of the dwarf forest", attributes=[("desc", """A side trail here leads from the dwarf forest.  It is definitely drier
and hotter here.  The trail continues to the west, and to the east, you see
the T-intersection."""), ("vnum", 5257)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The dwarf forest", attributes=[("desc", """You see more stunted trees here.  A side trail leads west from here.
To the east, you THINK you see a trail, but you can never be sure."""), ("vnum", 5258)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The dwarf forest", attributes=[("desc", """You see more stunted trees here.  It looks almost as if this place was
cursed by a god to be short and dry.  The trail leads north and south."""), ("vnum", 5259)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The dwarf forest", attributes=[("desc", """You see more stunted trees here.  It looks almost as if this place was
cursed by a god to be short and dry.  The trail leads north and south."""), ("vnum", 5260)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The dwarf forest", attributes=[("desc", """You see many stunted trees here.  You don't see any leaves on these barren
trees.  No grass grows on the ground."""), ("vnum", 5261)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The dwarf forest", attributes=[("desc", """You see more stunted trees here.  It looks almost as if this place was
cursed by a god to be short and dry.  The trail leads east and west.  It looks
dark toward the east."""), ("vnum", 5262)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The darker dwarf forest", attributes=[("desc", """You see a more dense foliage in these stunted trees.  The gloom caused
by them is enhanced by a draft coming from all around.  The trail turns south
from the west."""), ("vnum", 5263)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The darker dwarf forest", attributes=[("desc", """You see a more dense foliage in these stunted trees.  The gloom caused
by them is enhanced by a draft coming from all around.  The trail turns east
from the north."""), ("vnum", 5264)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The darker dwarf forest", attributes=[("desc", """You see a more dense foliage in these stunted trees.  The gloom caused
by them is enhanced by a draft coming from all around.  The trail leads
east and west."""), ("vnum", 5265)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The darker dwarf forest", attributes=[("desc", """You see a more dense foliage in these stunted trees.  The gloom caused
by them is enhanced by a draft coming from all around.  The trail leads
down into a valley and west."""), ("vnum", 5266)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A valley in the dark dwarf forest", attributes=[("desc", """You are in a valley in the dark dwarf forest.  Short black grass grows
around you.  Trails lead in all directions."""), ("vnum", 5267)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A small ugly cave", attributes=[("desc", """You see a small cave.  Skeletons of many types of creatures litter the area.
Obviously, no fox lives here!  The oppression makes you want to leave and
vomit."""), ("vnum", 5268)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="A small ugly cave", attributes=[("desc", """You are in a small ugly cave.  More skeletons lie around.  It is obvious
that the owner doesn't want you here.  The exit north is still visible.
Some writings are on this wall."""), ("vnum", 5269)], tags=["indoors"])
ev.create_object("typeclasses.rooms.Room", key="Down the path into a dead end", attributes=[("desc", """You are down the path.  There is no obvious exit in this place, exit the
one back up north.  All around you, you see skeletons."""), ("vnum", 5270)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The Valley in the dark dwarf forest", attributes=[("desc", """You are in a valley in the forest.  To the north is a trail out of this
dark valley.  South is more of this valley."""), ("vnum", 5271)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A dim trail in the dwarf forest", attributes=[("desc", """You are in a dim trail in the dwarf forest.  Not much light passes through
here.  To the south is a gloomy valley, while to the north the light grows
brighter."""), ("vnum", 5272)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A dim trail in the dwarf forest", attributes=[("desc", """You are in a dim trail in the dwarf forest.  Not much light passes through
here.  The trail runs north and south, and the light seems to come from the
north.  To the east, you see a small path into darkness."""), ("vnum", 5273)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A dim trail in the dwarf forest", attributes=[("desc", """You are in a dim trail in the dwarf forest.  Not much light passes through
here.  The trail runs north and south, and the light seems to come from the
north."""), ("vnum", 5274)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A bend in the dim trail in the dwarf forest", attributes=[("desc", """You are in a dim trail in the dwarf forest.  Not much light passes through
here.  The trail runs south and west.  The trail west looks much friendlier
than the one leading south."""), ("vnum", 5275)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A trail in the dwarf forest", attributes=[("desc", """You are in a trail in the dwarf forest.  The trees are stunted and it
looks dry around here.  The trail leads east and west.  It looks dimmer to
the east."""), ("vnum", 5276)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A trail in the dwarf forest", attributes=[("desc", """You are in a trail in the dwarf forest.  The trees are stunted and it
looks dry around here.  The trail leads east and west."""), ("vnum", 5277)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A trail in the dwarf forest", attributes=[("desc", """You are in a trail in the dwarf forest.  The trees are stunted and it
looks dry around here.  The trail leads east and west."""), ("vnum", 5278)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="The bend in the trail in the dwarf forest", attributes=[("desc", """You are in a bend in the trail in the forest.  The trees are stunted, but
not so dry around here.  The trail leads east, and to the south, you see a
waterfall."""), ("vnum", 5279)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="A dark bend in the forest", attributes=[("desc", """You are in a dark bend in the forest.  To the west, you see the trail
leading back to the dwarven forest, and to the south, you see a dark and
dismal path."""), ("vnum", 5280)], tags=["outdoors"])
ev.create_object("typeclasses.rooms.Room", key="By the beautiful waterfall", attributes=[("desc", """You see a VERY beautiful waterfall here.  It looks almost as if diamonds are
falling down the mountain.  (You reach out and grab and no, it IS only water.)
It looks so nice here, you feel like taking a nap.
The trail leads north and south."""), ("vnum", 5281)], tags=["outdoors"])

# Mobiles
ev.create_object("typeclasses.characters.Character", key="The mighty beholder", attributes=[("desc", """You meet a beholder's deadly gaze!"""), ("vnum", 5200)])
ev.create_object("typeclasses.characters.Character", key="The lamia", attributes=[("desc", """A strange lamia stands here waiting for her next meal."""), ("vnum", 5201)])
ev.create_object("typeclasses.characters.Character", key="The mimic", attributes=[("desc", """A strong chest lies in one corner of the room."""), ("vnum", 5202)])
ev.create_object("typeclasses.characters.Character", key="The mimic", attributes=[("desc", """Two skeletons lie crushed under a large boulder."""), ("vnum", 5203)])
ev.create_object("typeclasses.characters.Character", key="The mimic", attributes=[("desc", """The stone floor of this house has been ripped apart."""), ("vnum", 5204)])
ev.create_object("typeclasses.characters.Character", key="The mimic", attributes=[("desc", """Some broken shards of pottery lie strewn about the floor."""), ("vnum", 5205)])
ev.create_object("typeclasses.characters.Character", key="The mimic", attributes=[("desc", """A few wooden planks lie stacked on a low shelf."""), ("vnum", 5206)])
ev.create_object("typeclasses.characters.Character", key="The horned lizard", attributes=[("desc", """A small horned lizard flicks his tongue and slithers away."""), ("vnum", 5207)])
ev.create_object("typeclasses.characters.Character", key="The stone golem", attributes=[("desc", """In the corner you see a large, stone golem faithfully standing watch."""), ("vnum", 5208)])

# Objects
ev.create_object("typeclasses.objects.Object", key="a mithril vest", attributes=[("desc", """A vest made of mithril plates lies heaped on the floor."""), ("vnum", 5200)])
